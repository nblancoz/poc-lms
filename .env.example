# Server
PORT=3000

# PostgreSQL (Docker Compose & Local DB)
POSTGRES_USER=poc_lms
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=poc_lms
POSTGRES_PORT=5432

# Prisma Database Connection
DATABASE_URL=postgresql://poc_lms:your_secure_password@localhost:5432/poc_lms

# Authentication & AI
JWT_SECRET=your_jwt_secret_key
# AI Provider: 'mock' (default, zero-config for offline evaluations) or 'gemini'
AI_PROVIDER=mock
# Optional: Required only if AI_PROVIDER is set to 'gemini'
GEMINI_API_KEY=your_gemini_api_key_here